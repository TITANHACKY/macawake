#!/bin/bash
# awake: keep a Mac awake (even with the lid closed), then restore sleep.
#
# Designed for MDM-managed Macs that grant admin for only a few minutes.
# Admin is needed ONCE, for setup. After that, no admin or password is needed.
#
# Version: 1.3.0

shopt -s nullglob

VERSION="1.3.0"
R="${AWAKE_TEST_ROOT:-}"
SUPPORT="$R/Library/Application Support/awake"
SESSION_ROOT="$SUPPORT/sessions"
SESSIONS="$SESSION_ROOT/$UID"
REQUEST_ROOT="$SUPPORT/requests"
REQUEST="$REQUEST_ROOT/$UID"
STATUS_ROOT="$SUPPORT/status"
STATUS="$STATUS_ROOT/$UID"
CONFIG="$SUPPORT/config"
USER_CONFIG="$HOME/.config/macawake/config"
LIBEXEC="$R/usr/local/libexec"
GUARD_BIN="$LIBEXEC/awake-guard"
PLIST="$R/Library/LaunchDaemons/com.awake.guard.plist"
DLABEL="com.awake.guard"
BIN="$R/usr/local/bin/awake"
PM="${AWAKE_PMSET:-/usr/bin/pmset}"

# Default Preferences
DEFAULT_BATT_GUARD=1
DEFAULT_BATT_THRESHOLD=30
BATT_GUARD=$DEFAULT_BATT_GUARD
BATT_THRESHOLD=$DEFAULT_BATT_THRESHOLD

# ANSI Colors
C_RESET="\033[0m"
C_BOLD="\033[1m"
C_CYAN="\033[1;36m"
C_GREEN="\033[1;32m"
C_YELLOW="\033[1;33m"
C_RED="\033[1;31m"
C_DIM="\033[2m"
C_BLUE="\033[1;34m"
C_MAGENTA="\033[1;35m"

TUI_ACTIVE=0
CMD_PID=""
TIMER_PID=""
IDLE_PID=""
SESSION_FILE=""

# ---- Preferences Management ----

load_config() {
  BATT_GUARD=$DEFAULT_BATT_GUARD
  BATT_THRESHOLD=$DEFAULT_BATT_THRESHOLD
  local target=""
  # A user config is authoritative when the shared config is read-only or was
  # created by an earlier install that could not update it.
  if [ -f "$USER_CONFIG" ]; then
    target="$USER_CONFIG"
  elif [ -f "$CONFIG" ]; then
    target="$CONFIG"
  fi
  if [ -n "$target" ]; then
    local val_en val_th
    val_en=$(awk -F= '/^BATTERY_GUARD_ENABLED=/{print $2}' "$target" 2>/dev/null | tr -d ' "')
    val_th=$(awk -F= '/^BATTERY_GUARD_THRESHOLD=/{print $2}' "$target" 2>/dev/null | tr -d ' "%')
    [ -n "$val_en" ] && BATT_GUARD="$val_en"
    if [ -n "$val_th" ] && [[ "$val_th" =~ ^[0-9]+$ ]] && [ "$val_th" -ge 0 ] && [ "$val_th" -le 100 ]; then
      BATT_THRESHOLD="$val_th"
    fi
  fi
}

save_config() {
  local target="$CONFIG"
  local config_dir
  config_dir=$(dirname "$CONFIG")
  if { [ -f "$CONFIG" ] && [ ! -w "$CONFIG" ]; } || { [ ! -e "$CONFIG" ] && [ ! -w "$config_dir" ]; }; then
    target="$USER_CONFIG"
  fi
  mkdir -p "$(dirname "$target")" 2>/dev/null || return 1
  local tmp="${target}.tmp.$$"
  if ! printf 'BATTERY_GUARD_ENABLED=%s\nBATTERY_GUARD_THRESHOLD=%s\n' "$BATT_GUARD" "$BATT_THRESHOLD" > "$tmp"; then
    rm -f "$tmp" 2>/dev/null || true
    return 1
  fi
  if ! mv -f "$tmp" "$target" 2>/dev/null; then
    rm -f "$tmp" 2>/dev/null || true
    return 1
  fi
  chmod 644 "$target" 2>/dev/null || true
  return 0
}

show_battery_pref() {
  load_config
  if [ "$BATT_GUARD" -eq 1 ] && [ "$BATT_THRESHOLD" -gt 0 ]; then
    echo "Battery Guard Preference: ENABLED (Auto-sleeps when battery <= ${BATT_THRESHOLD}%)"
  else
    echo "Battery Guard Preference: DISABLED"
  fi
}

set_battery_pref() {
  local val="$1"
  load_config
  val=$(echo "$val" | tr -d '% ')
  if [ "$val" = "off" ] || [ "$val" = "disable" ] || [ "$val" = "0" ]; then
    BATT_GUARD=0
    save_config || { echo "Unable to save the battery guard preference." >&2; exit 1; }
    echo "Battery Guard preference updated: DISABLED"
  elif [[ "$val" =~ ^[0-9]+$ ]] && [ "$val" -ge 1 ] && [ "$val" -le 100 ]; then
    BATT_GUARD=1
    BATT_THRESHOLD="$val"
    save_config || { echo "Unable to save the battery guard preference." >&2; exit 1; }
    echo "Battery Guard preference updated: ENABLED (${BATT_THRESHOLD}%)"
    echo "Mac will automatically restore normal sleep if battery drops <= ${BATT_THRESHOLD}%."
  else
    echo "Invalid battery threshold '$1'. Specify a number between 1 and 100 (e.g. 30, 25%), or 'off' to disable."
    exit 1
  fi
}

# ---- Status & Helper Checks ----

sleep_is_disabled() {
  [ "$("$PM" -g 2>/dev/null | awk '/SleepDisabled/{print $2}')" = "1" ]
}

DAEMON_STATUS_TIMESTAMP=0
DAEMON_STATUS_PID=""
DAEMON_STATUS_DESIRED=0
DAEMON_STATUS_SLEEP_DISABLED=0
DAEMON_STATUS_SESSIONS=0
DAEMON_STATUS_REASON="unknown"
DAEMON_STATUS_ERROR=0
DAEMON_HEALTH_STATE="UNKNOWN"

read_daemon_status() {
  DAEMON_STATUS_TIMESTAMP=0
  DAEMON_STATUS_PID=""
  DAEMON_STATUS_DESIRED=0
  DAEMON_STATUS_SLEEP_DISABLED=0
  DAEMON_STATUS_SESSIONS=0
  DAEMON_STATUS_REASON="unknown"
  DAEMON_STATUS_ERROR=0
  [ -r "$STATUS" ] || return 1
  local key value
  while IFS='=' read -r key value; do
    case "$key" in
      timestamp) DAEMON_STATUS_TIMESTAMP="$value" ;;
      pid) DAEMON_STATUS_PID="$value" ;;
      desired) DAEMON_STATUS_DESIRED="$value" ;;
      sleep_disabled) DAEMON_STATUS_SLEEP_DISABLED="$value" ;;
      sessions) DAEMON_STATUS_SESSIONS="$value" ;;
      reason) DAEMON_STATUS_REASON="$value" ;;
      pmset_error) DAEMON_STATUS_ERROR="$value" ;;
    esac
  done < "$STATUS"
  [[ "$DAEMON_STATUS_TIMESTAMP" =~ ^[0-9]+$ ]] || return 1
  return 0
}

daemon_health_state() {
  local paused="${1:-0}" now age
  if ! read_daemon_status; then
    DAEMON_HEALTH_STATE="UNKNOWN"
    echo "$DAEMON_HEALTH_STATE"
    return 0
  fi
  now=$(date +%s)
  age=$(( now - DAEMON_STATUS_TIMESTAMP ))
  if [ "$age" -lt 0 ] || [ "$age" -gt 8 ]; then
    DAEMON_HEALTH_STATE="UNAVAILABLE"
  elif [ "$DAEMON_STATUS_ERROR" = 1 ]; then
    DAEMON_HEALTH_STATE="DEGRADED"
  elif [ "$paused" = 1 ] || [ "$DAEMON_STATUS_REASON" = "paused" ]; then
    DAEMON_HEALTH_STATE="PAUSED"
  elif [ "$DAEMON_STATUS_DESIRED" = 1 ] && [ "$DAEMON_STATUS_SLEEP_DISABLED" = 1 ]; then
    DAEMON_HEALTH_STATE="HEALTHY"
  elif [ "$DAEMON_STATUS_DESIRED" = 1 ]; then
    DAEMON_HEALTH_STATE="STARTING"
  else
    DAEMON_HEALTH_STATE="IDLE"
  fi
  echo "$DAEMON_HEALTH_STATE"
}

request_set() {
  local tmp="${REQUEST}.tmp.$$"
  if printf '%s\n' "$1" > "$tmp" 2>/dev/null && mv -f "$tmp" "$REQUEST" 2>/dev/null; then
    return 0
  fi
  rm -f "$tmp" 2>/dev/null || true
  return 1
}

session_set() {
  local state="$1" pid="$2" until="${3:-0}"
  mkdir -p "$SESSIONS" 2>/dev/null || return 1
  SESSION_FILE="$SESSIONS/$pid.session"
  local tmp
  tmp=$(mktemp "$SESSIONS/.session.XXXXXX" 2>/dev/null) || return 1
  if ! printf 'state=%s pid=%s uid=%s until=%s started=%s\n' "$state" "$pid" "$UID" "$until" "$(date +%s)" > "$tmp" 2>/dev/null || ! mv -f "$tmp" "$SESSION_FILE" 2>/dev/null; then
    rm -f "$tmp" 2>/dev/null || true
    return 1
  fi

  # Legacy compatibility request file update
  if [ "$state" = "on" ]; then
    if [ "$until" -gt 0 ]; then
      request_set "on pid=$pid until=$until"
    else
      request_set "on pid=$pid"
    fi
  else
    request_set "off"
  fi
}

session_remove() {
  local pid="$1"
  [ -n "$pid" ] && rm -f "$SESSIONS/$pid.session" 2>/dev/null || true
  local count=0
  if [ -d "$SESSIONS" ]; then
    for sf in "$SESSIONS"/*.session; do
      count=$((count + 1))
    done
  fi
  if [ "$count" -eq 0 ]; then
    request_set "off"
  fi
}

session_count() {
  local count=0 sf
  if [ -d "$SESSIONS" ]; then
    for sf in "$SESSIONS"/*.session; do
      count=$((count + 1))
    done
  fi
  echo "$count"
}

poll_until() {  # $1=want (0/1), up to ~6s
  local want="$1" i
  for i in $(seq 1 30); do
    if [ "$want" = 1 ]; then sleep_is_disabled && return 0
    else sleep_is_disabled || return 0; fi
    sleep 0.2
  done
  return 1
}

check_battery_guard_preflight() {
  load_config
  if [ "$BATT_GUARD" -eq 1 ] && [ "$BATT_THRESHOLD" -gt 0 ]; then
    get_power_info
    if [ "$BATT_SRC" = "Battery Power" ] && [ -n "$BATT_PCT" ] && [ "$BATT_PCT" -le "$BATT_THRESHOLD" ] 2>/dev/null; then
      printf "${C_YELLOW}⚠️  MacAwake Battery Guard Alert:${C_RESET} Current battery is ${C_BOLD}%s%%${C_RESET} (at or below cutoff: %s%%).\n" \
        "$BATT_PCT" "$BATT_THRESHOLD"
      printf "MacAwake automatically blocked sleep prevention to protect your Mac from dying.\n\n"
      printf "To stay awake:\n"
      printf "  • Connect MagSafe / USB-C power charger, OR\n"
      local suggested=$(( BATT_PCT > 10 ? BATT_PCT - 5 : 5 ))
      printf "  • Lower safety cutoff:   ${C_CYAN}awake -b %s${C_RESET}\n" "$suggested"
      printf "  • Disable safety cutoff: ${C_CYAN}awake -b off${C_RESET}\n\n"
      return 1
    fi
  fi
  return 0
}

handle_poll_failure() {
  local want="$1"
  if [ "$want" = 1 ]; then
    load_config
    get_power_info
    if [ "$BATT_GUARD" -eq 1 ] && [ "$BATT_THRESHOLD" -gt 0 ] && [ "$BATT_SRC" = "Battery Power" ] && [ -n "$BATT_PCT" ] && [ "$BATT_PCT" -le "$BATT_THRESHOLD" ] 2>/dev/null; then
      printf "${C_YELLOW}⚠️  MacAwake Battery Guard active:${C_RESET} Sleep prevention was blocked.\n"
      printf "   Battery is at ${C_BOLD}%s%%${C_RESET} (cutoff is %s%%).\n" "$BATT_PCT" "$BATT_THRESHOLD"
      printf "   Plug into power or change cutoff: ${C_CYAN}awake -b off${C_RESET} or ${C_CYAN}awake -b %s${C_RESET}\n" "$(( BATT_PCT > 10 ? BATT_PCT - 5 : 5 ))"
    else
      daemon_health_state 0 >/dev/null
      if [ "$DAEMON_HEALTH_STATE" = "UNAVAILABLE" ] || [ "$DAEMON_HEALTH_STATE" = "UNKNOWN" ]; then
        echo "The background service isn't reporting a heartbeat."
        echo "Run diagnostics:  awake doctor"
      elif [ "$DAEMON_HEALTH_STATE" = "DEGRADED" ]; then
        echo "The background service reported a pmset error."
        echo "Run diagnostics:  awake doctor"
      elif ! daemon_loaded; then
        echo "The background service isn't loaded in launchd."
        echo "Run once during an admin window:  sudo awake --install"
      else
        echo "The background service did not respond in time."
        echo "Run diagnostics:  awake doctor"
      fi
    fi
  fi
}

daemon_loaded() {
  command -v launchctl >/dev/null 2>&1 || return 1
  launchctl print "system/$DLABEL" >/dev/null 2>&1 || launchctl list 2>/dev/null | grep -q "$DLABEL"
}

not_set_up() {
  echo "awake isn't set up on this Mac yet (or the service was removed)."
  echo "Run once during an admin window:  sudo awake --install"
  exit 1
}

to_seconds() {
  local s="$1" total=0 num unit
  if [[ "$s" =~ ^[0-9]+$ ]]; then echo $((10#$s * 60)); return 0; fi
  [[ "$s" =~ ^([0-9]+[hms])+$ ]] || return 1
  while [[ "$s" =~ ^([0-9]+)([hms])(.*)$ ]]; do
    num=${BASH_REMATCH[1]}; unit=${BASH_REMATCH[2]}; s=${BASH_REMATCH[3]}
    case "$unit" in
      h) total=$((total + 10#$num * 3600)) ;;
      m) total=$((total + 10#$num * 60)) ;;
      s) total=$((total + 10#$num)) ;;
    esac
  done
  echo "$total"
}

fmt_duration() {
  local s=$1 h m sec
  if [ "$s" -le 0 ]; then echo "00h 00m 00s"; return; fi
  h=$(( s / 3600 ))
  m=$(( (s % 3600) / 60 ))
  sec=$(( s % 60 ))
  printf "%02dh %02dm %02ds" "$h" "$m" "$sec"
}

progress_bar() {
  local pct=$1 width=${2:-22} filled empty
  [ "$pct" -lt 0 ] && pct=0
  [ "$pct" -gt 100 ] && pct=100
  filled=$(( pct * width / 100 ))
  empty=$(( width - filled ))
  printf "["
  local i
  for ((i=0; i<filled; i++)); do printf "█"; done
  for ((i=0; i<empty; i++)); do printf "░"; done
  printf "] %3d%%" "$pct"
}

get_power_info() {
  local raw
  raw=$("$PM" -g batt 2>/dev/null || true)
  if [ -z "$raw" ]; then
    BATT_SRC="AC Power"
    BATT_PCT="100"
    BATT_STATE="charged"
    BATT_TIME=""
    return
  fi
  BATT_SRC=$(printf '%s\n' "$raw" | awk -F"'" 'NR==1{print $2}')
  [ -z "$BATT_SRC" ] && BATT_SRC="Unknown"
  BATT_PCT=$(printf '%s\n' "$raw" | grep -Eo '[0-9]+%' | head -1 | tr -d '%')
  [ -z "$BATT_PCT" ] && BATT_PCT="100"
  BATT_TIME=$(printf '%s\n' "$raw" | grep -Eo '[0-9]+:[0-9]+' | head -1)
  if printf '%s\n' "$raw" | grep -qi "discharging"; then
    BATT_STATE="discharging"
  elif printf '%s\n' "$raw" | grep -qi "charging"; then
    BATT_STATE="charging"
  else
    BATT_STATE="charged"
  fi
}

# ---- Help, Version & Diagnostics ----

show_help() {
  load_config
  cat << EOF
awake — Keep your Mac awake even with the lid closed, then restore normal sleep.

USAGE:
    awake [OPTIONS] [COMMAND...]

MODES:
    awake                      Launch interactive Trading Terminal (live TUI dashboard)
    awake -t <duration>        Stay awake for <duration> (opens Trading Terminal)
    awake <command...>         Stay awake in background while <command> runs, then restore sleep
    awake -t <time> <cmd...>   Run <command>, staying awake for at most <time>
    awake -i, awake shell      Explicitly open Trading Terminal
    awake --plain              Run plain non-interactive session (press Ctrl+C to stop)

OPTIONS:
    -t <duration>              Timer duration (e.g. 45, 30s, 15m, 2h, 1h30m; plain number = minutes)
    -b, --battery-guard [N%]   Set or view battery cutoff preference (default: 30%, 'off' to disable)
    -s, --status               Show sleep status, active sessions, and battery power metrics
    --off [PID]                Stop one session by PID, or all sessions for this account
    --off --all                Explicit alias for stopping all sessions for this account
    -d, --doctor               Run diagnostics on daemon, permissions, and system settings
    -v, --version              Show version information
    -h, --help                 Display this help guide

ADMIN SETUP (Requires sudo once):
    sudo awake --install [user]   Install LaunchDaemon root service for [user]
    sudo awake --uninstall        Remove LaunchDaemon service and clean up all files

TRADING TERMINAL HOTKEYS:
    [+] / [e]   Extend timer (+15 minutes)
    [-]         Shorten timer (-15 minutes)
    [t]         Set new timer duration (e.g. 45m, 2h, inf)
    [p] / [spc] Pause or Resume sleep prevention toggle
    [d]         Sleep display backlight (runs headless, prevents heat with closed lid)
    [b]         Set or toggle battery guard threshold (current: ${BATT_THRESHOLD}%)
    [r]         Execute shell command while holding awake lock
    [?] / [h]   Toggle help cheat sheet modal
    [q]         Exit cleanly and restore sleep for this session

HOW IT WORKS:
    macOS normally sleeps when the laptop lid closes, ignoring caffeinate and power
    assertions. awake uses the root-level 'pmset -a disablesleep 1' flag via a tiny
    LaunchDaemon background service. You grant admin ONCE at install. After that, daily
    use requires NO admin password, NO sudo, and works seamlessly even on MDM-managed Macs.
    The service constantly verifies active sessions and restores sleep automatically if
    your terminal closes, a process exits, or the timer finishes.

SAFETY:
    - Battery Protection: Defaults to 30% cutoff. Auto-restores sleep when battery <= threshold.
    - Bag Warning: Always sleep or shut down your Mac before placing it in a closed bag.
EOF
}

show_version() {
  echo "awake v$VERSION — Lid-closed sleep manager for macOS"
}

show_status() {
  get_power_info
  load_config
  daemon_health_state 0 >/dev/null
  echo "MacAwake Status:"
  if sleep_is_disabled; then
    echo "  Sleep Prevention : ENABLED (Mac stays awake with lid closed)"
  else
    echo "  Sleep Prevention : DISABLED (Sleep is normal)"
  fi
  if [ "$BATT_SRC" = "AC Power" ]; then
    echo "  Power Source     : ⚡ AC Connected ($BATT_PCT%, $BATT_STATE)"
  else
    local t_rem="${BATT_TIME:+ ($BATT_TIME remaining)}"
    echo "  Power Source     : 🔋 Battery Power ($BATT_PCT%, $BATT_STATE$t_rem)"
  fi

  if [ "$BATT_GUARD" -eq 1 ] && [ "$BATT_THRESHOLD" -gt 0 ]; then
    echo "  Battery Guard    : ACTIVE (Cutoff threshold: <= ${BATT_THRESHOLD}%)"
  else
    echo "  Battery Guard    : DISABLED"
  fi

  if command -v launchctl >/dev/null 2>&1; then
    if daemon_loaded; then
      echo "  Background Guard : Active (com.awake.guard loaded in launchd)"
    else
      echo "  Background Guard : Not loaded (run: sudo awake --install)"
    fi
  fi
  echo "  Daemon Health    : $DAEMON_HEALTH_STATE"
  if read_daemon_status; then
    echo "  Daemon Heartbeat  : ${DAEMON_STATUS_TIMESTAMP} (${DAEMON_STATUS_REASON}, sessions: ${DAEMON_STATUS_SESSIONS})"
  else
    echo "  Daemon Heartbeat  : unavailable"
  fi

  echo "  Active Sessions  :"
  local count=0
  if [ -d "$SESSIONS" ]; then
    local now
    now=$(date +%s)
    for sf in "$SESSIONS"/*.session; do
      local spid="" suid="" suntil=0 sstate="on"
      for kv in $(cat "$sf" 2>/dev/null); do
        case "$kv" in
          pid=*) spid="${kv#pid=}" ;;
          uid=*) suid="${kv#uid=}" ;;
          until=*) suntil="${kv#until=}" ;;
          state=*) sstate="${kv#state=}" ;;
        esac
      done
      if [ -n "$spid" ] && kill -0 "$spid" 2>/dev/null; then
        count=$(( count + 1 ))
        local u_name
        u_name=$(id -nu "$suid" 2>/dev/null || echo "uid $suid")
        local rem_str="indefinite"
        if [ "$suntil" -gt 0 ] 2>/dev/null; then
          local left=$(( suntil - now ))
          if [ "$left" -gt 0 ]; then
            rem_str="$(fmt_duration "$left") remaining"
          else
            rem_str="expired"
          fi
        fi
        echo "    • PID $spid ($u_name) [state: $sstate] - $rem_str"
      fi
    done
  fi
  if [ "$count" -eq 0 ]; then
    echo "    None"
  fi
}

run_doctor() {
  echo "=== MacAwake Doctor Diagnostics ==="
  if [ "$(uname -s)" = "Darwin" ]; then
    echo "  [✓] OS: macOS $(sw_vers -productVersion 2>/dev/null || uname -r) ($(uname -m))"
  else
    echo "  [✗] OS: Unsupported OS ($(uname -s)). MacAwake requires macOS."
  fi

  if [ -f "$PLIST" ]; then
    echo "  [✓] LaunchDaemon plist: Found at $PLIST"
  else
    echo "  [✗] LaunchDaemon plist: Missing at $PLIST"
    echo "      Fix: sudo awake --install"
  fi

  if command -v launchctl >/dev/null 2>&1; then
    if daemon_loaded; then
      echo "  [✓] LaunchDaemon service: $DLABEL is active"
    else
      echo "  [!] LaunchDaemon service: $DLABEL is not running in launchd"
      echo "      Fix: sudo launchctl load -w $PLIST"
    fi
  fi

  if [ -x "$GUARD_BIN" ]; then
    echo "  [✓] Guard script: Found and executable at $GUARD_BIN"
  else
    echo "  [✗] Guard script: Missing or not executable at $GUARD_BIN"
    echo "      Fix: sudo awake --install"
  fi

  daemon_health_state 0 >/dev/null
  case "$DAEMON_HEALTH_STATE" in
    HEALTHY|IDLE|PAUSED|STARTING)
      echo "  [✓] Daemon heartbeat: $DAEMON_HEALTH_STATE"
      ;;
    *)
      echo "  [!] Daemon heartbeat: $DAEMON_HEALTH_STATE"
      echo "      Fix: sudo awake --install, then run awake doctor again"
      ;;
  esac

  if [ -d "$SUPPORT" ]; then
    echo "  [✓] App Support directory: Found at $SUPPORT"
    if [ -w "$REQUEST" ]; then
      echo "  [✓] Request file: Writable by $(whoami)"
    else
      echo "  [!] Request file: Not writable by $(whoami)"
    fi
    if [ -d "$SESSIONS" ] && [ -w "$SESSIONS" ]; then
      echo "  [✓] Sessions directory: Writable by $(whoami)"
    else
      echo "  [!] Sessions directory: Not writable by $(whoami)"
    fi
  else
    echo "  [!] App Support directory: Missing at $SUPPORT"
    echo "      Fix: sudo awake --install"
  fi

  load_config
  if [ -f "$CONFIG" ]; then
    echo "  [✓] Config file: Found at $CONFIG (Battery guard: ${BATT_THRESHOLD}%, enabled: $BATT_GUARD)"
  elif [ -f "$USER_CONFIG" ]; then
    echo "  [✓] Config file: Found at $USER_CONFIG (Battery guard: ${BATT_THRESHOLD}%, enabled: $BATT_GUARD)"
  else
    echo "  [i] Config file: Default settings (Battery guard: ${DEFAULT_BATT_THRESHOLD}%, enabled: $DEFAULT_BATT_GUARD)"
  fi

  get_power_info
  echo "  [✓] Power Status: $BATT_SRC ($BATT_PCT%, $BATT_STATE)"
  if sleep_is_disabled; then
    echo "  [i] pmset status: SleepDisabled=1 (Mac stays awake with lid closed)"
  else
    echo "  [i] pmset status: SleepDisabled=0 (Normal sleep)"
  fi
  echo "==================================="
}

turn_off() {
  [ -d "$SUPPORT" ] || not_set_up
  local target_pid="${1:-}" removed=0 sf spid
  for sf in "$SESSIONS"/*.session; do
    spid=$(awk '{for (i = 1; i <= NF; i++) if ($i ~ /^pid=/) {sub(/^pid=/, "", $i); print $i; exit}}' "$sf" 2>/dev/null)
    if [ -z "$target_pid" ] || [ "$spid" = "$target_pid" ]; then
      rm -f "$sf" 2>/dev/null || true
      removed=$((removed + 1))
    fi
  done
  if [ "$(session_count)" -gt 0 ]; then
    if [ "$removed" -gt 0 ]; then
      echo "Stopped session $target_pid. Other awake sessions remain active."
    else
      echo "No matching awake session found. Other awake sessions remain active."
    fi
    return 0
  fi
  request_set off
  if poll_until 0; then
    if [ "$removed" -gt 0 ]; then
      echo "Sleep is back to normal."
    else
      echo "No active awake session found. Sleep is normal."
    fi
  else
    echo "Service didn't respond. Is it installed? Try reinstalling with: sudo awake --install"
  fi
}

# ---- Service & Daemon Setup ----

write_guard() {
  mkdir -p "$LIBEXEC"
  local guard_tmp="${GUARD_BIN}.tmp.$$"
  cat > "$guard_tmp" << 'GUARD'
#!/bin/bash
# Runs as root via launchd. Reads the target user's session and request files and applies the
# desired sleep state. The loop keeps response time independent of launchd's
# file-watch scheduling; KeepAlive restarts it if it is terminated.
shopt -s nullglob
SUPPORT="/Library/Application Support/awake"
SESSIONS="$SUPPORT/sessions"
REQUEST="$SUPPORT/request"
CONFIG="$SUPPORT/config"
STATUS="$SUPPORT/status"
USER_CONFIG=""
GUARD
  printf 'SESSIONS=%q\nREQUEST=%q\nSTATUS=%q\nUSER_CONFIG=%q\n' \
    "${GUARD_SESSIONS:-$SESSIONS}" "${GUARD_REQUEST:-$REQUEST}" \
    "${GUARD_STATUS:-$STATUS}" "${GUARD_USER_CONFIG:-}" >> "$guard_tmp"
  cat >> "$guard_tmp" << 'GUARD'
PMSET=/usr/bin/pmset

write_status() {
  local tmp="${STATUS}.tmp.$$"
  mkdir -p "$(dirname "$STATUS")" 2>/dev/null || return 1
  printf 'timestamp=%s\npid=%s\ndesired=%s\nsleep_disabled=%s\nsessions=%s\nreason=%s\npmset_error=%s\n' \
    "$now" "$$" "$want" "$cur" "$active_sessions" "$reason" "$pmset_error" > "$tmp" 2>/dev/null || return 1
  chmod 644 "$tmp" 2>/dev/null || true
  mv -f "$tmp" "$STATUS" 2>/dev/null || {
    rm -f "$tmp" 2>/dev/null || true
    return 1
  }
}

while :; do
now=$(date +%s)
want=0
active_sessions=0
reason="no_sessions"
pmset_error=0

# 1. Check all multi-session files
if [ -d "$SESSIONS" ]; then
  for sfile in "$SESSIONS"/*.session; do
    s_pid=""; s_uid=""; s_until=0; s_state="on"
    for kv in $(cat "$sfile" 2>/dev/null); do
      case "$kv" in
        pid=*)   s_pid="${kv#pid=}" ;;
        uid=*)   s_uid="${kv#uid=}" ;;
        until=*) s_until="${kv#until=}" ;;
        state=*) s_state="${kv#state=}" ;;
      esac
    done

    valid=1
    if [ -n "$s_pid" ]; then
      if ! kill -0 "$s_pid" 2>/dev/null; then
        valid=0
      elif [ -n "$s_uid" ]; then
        real_uid=$(ps -o uid= -p "$s_pid" 2>/dev/null | tr -d ' ')
        [ "$real_uid" = "$s_uid" ] || valid=0
      fi
    else
      valid=0
    fi

    if [ "$s_until" -gt 0 ] 2>/dev/null && [ "$now" -ge "$s_until" ]; then
      valid=0
    fi

    if [ "$valid" -eq 1 ]; then
      active_sessions=$((active_sessions + 1))
      [ "$s_state" = "on" ] && want=1
    else
      rm -f "$sfile" 2>/dev/null
    fi
  done
fi

# 2. Compatibility check with the per-user request file
if [ "$want" -eq 0 ] && [ -r "$REQUEST" ]; then
  req=$(cat "$REQUEST" 2>/dev/null)
  req_parts=()
  read -r -a req_parts <<< "$req"
  if [ "${req_parts[0]}" = "on" ]; then
    legit=1
    for kv in "${req_parts[@]:1}"; do
      case "$kv" in
        pid=*)   p=${kv#pid=};   kill -0 "$p" 2>/dev/null || legit=0 ;;
        until=*) u=${kv#until=}; [ "$now" -lt "$u" ] 2>/dev/null || legit=0 ;;
      esac
    done
    [ "$legit" -eq 1 ] && want=1
  fi
fi

# 3. Battery Safeguard: Read config preference (default 30%). If the shared
# config became read-only, honor the user's fallback config as well.
b_en=1
b_cutoff=30
config_file="$USER_CONFIG"
[ -f "$config_file" ] || config_file="$CONFIG"
if [ -n "$config_file" ]; then
  c_en=$(awk -F= '/^BATTERY_GUARD_ENABLED=/{print $2}' "$config_file" 2>/dev/null | tr -d ' "')
  c_th=$(awk -F= '/^BATTERY_GUARD_THRESHOLD=/{print $2}' "$config_file" 2>/dev/null | tr -d ' "%')
  [ -n "$c_en" ] && b_en="$c_en"
  if [ -n "$c_th" ] && [ "$c_th" -ge 0 ] 2>/dev/null; then
    b_cutoff="$c_th"
  fi
fi

if [ "$want" -eq 1 ] && [ "$b_en" -eq 1 ] && [ "$b_cutoff" -gt 0 ]; then
  batt_raw=$("$PMSET" -g batt 2>/dev/null || true)
  batt_src=$(printf '%s\n' "$batt_raw" | awk -F"'" 'NR==1{print $2}')
  if [ "$batt_src" = "Battery Power" ]; then
    batt_lvl=$(printf '%s\n' "$batt_raw" | grep -Eo '[0-9]+%' | head -1 | tr -d '%')
    if [ -n "$batt_lvl" ] && [ "$batt_lvl" -le "$b_cutoff" ] 2>/dev/null; then
      want=0
      reason="battery_low"
    fi
  fi
fi

[ "$want" -eq 1 ] && reason="active"
[ "$active_sessions" -gt 0 ] && [ "$want" -eq 0 ] && [ "$reason" = "no_sessions" ] && reason="paused"

# 4. Apply state if changed
cur=$("$PMSET" -g 2>/dev/null | awk '/SleepDisabled/{print $2}'); [ -n "$cur" ] || cur=0
if [ "$want" = 1 ] && [ "$cur" != 1 ]; then
  "$PMSET" -a disablesleep 1 || { pmset_error=1; reason="pmset_error"; }
fi
if [ "$want" = 0 ]; then
  if [ "$cur" != 0 ]; then
    "$PMSET" -a disablesleep 0 || { pmset_error=1; reason="pmset_error"; }
  fi
  if [ -r "$REQUEST" ] && [ "$(cat "$REQUEST" 2>/dev/null)" != "off" ]; then
    echo off > "$REQUEST" 2>/dev/null
  fi
fi
cur=$("$PMSET" -g 2>/dev/null | awk '/SleepDisabled/{print $2}'); [ -n "$cur" ] || cur=0
write_status || true
sleep 2
done
GUARD
  if ! chmod 755 "$guard_tmp" || ! bash -n "$guard_tmp"; then
    rm -f "$guard_tmp"
    return 1
  fi
  mv -f "$guard_tmp" "$GUARD_BIN"
}

write_plist() {
  local plist_tmp="${PLIST}.tmp.$$"
  mkdir -p "$(dirname "$PLIST")"
  cat > "$plist_tmp" << PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>$DLABEL</string>
  <key>ProgramArguments</key>
  <array><string>/bin/bash</string><string>/usr/local/libexec/awake-guard</string></array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ProcessType</key><string>Background</string>
  <key>StandardErrorPath</key><string>/var/log/awake-guard.log</string>
</dict>
</plist>
PLIST
  if ! chmod 644 "$plist_tmp"; then
    rm -f "$plist_tmp"
    return 1
  fi
  if command -v plutil >/dev/null 2>&1 && ! plutil -lint "$plist_tmp" >/dev/null 2>&1; then
    rm -f "$plist_tmp"
    return 1
  fi
  mv -f "$plist_tmp" "$PLIST"
}

install_awake() {
  [ "$(id -u)" -eq 0 ] || { echo "Setup needs admin. Run:  sudo awake --install"; exit 1; }
  local quiet=0
  local user=""
  for arg in "$@"; do
    case "$arg" in
      --quiet|-q) quiet=1 ;;
      *) [ -z "$user" ] && user="$arg" ;;
    esac
  done
  [ -z "$user" ] && user="$SUDO_USER"
  if [ -z "$user" ] || [ "$user" = root ] || ! id "$user" >/dev/null 2>&1; then
    echo "Couldn't tell which account will use awake."
    echo "Run:  sudo awake --install <your-username>"
    exit 1
  fi
  local user_home=""
  if command -v dscl >/dev/null 2>&1; then
    user_home=$(dscl . -read "/Users/$user" NFSHomeDirectory 2>/dev/null | awk '{print $2}')
  fi
  [ -n "$user_home" ] || user_home="/Users/$user"
  local target_uid
  target_uid=$(id -u "$user")
  GUARD_SESSIONS="$SESSION_ROOT/$target_uid"
  GUARD_REQUEST="$REQUEST_ROOT/$target_uid"
  GUARD_STATUS="$STATUS_ROOT/$target_uid"
  GUARD_USER_CONFIG="$user_home/.config/macawake/config"
  mkdir -p "$SUPPORT" "$SESSION_ROOT" "$GUARD_SESSIONS" "$REQUEST_ROOT" "$STATUS_ROOT" "$(dirname "$BIN")"
  : > "$GUARD_REQUEST"; echo off > "$GUARD_REQUEST"
  if [ ! -f "$CONFIG" ]; then
    cat > "$CONFIG" << EOF
BATTERY_GUARD_ENABLED=$DEFAULT_BATT_GUARD
BATTERY_GUARD_THRESHOLD=$DEFAULT_BATT_THRESHOLD
EOF
  fi
  chown -R "$user" "$SUPPORT"
  chmod 755 "$SUPPORT"
  chmod 755 "$SESSION_ROOT" "$REQUEST_ROOT" "$STATUS_ROOT"
  chmod 700 "$GUARD_SESSIONS"
  chown "$user" "$GUARD_SESSIONS"; chmod 700 "$GUARD_SESSIONS"
  chown "$user" "$GUARD_REQUEST"; chmod 644 "$GUARD_REQUEST"
  chown "$user" "$CONFIG" 2>/dev/null || true
  chmod 644 "$CONFIG" 2>/dev/null || true

  local bin_tmp="${BIN}.tmp.$$"
  if ! install -m 755 "$0" "$bin_tmp" || ! bash -n "$bin_tmp" || ! mv -f "$bin_tmp" "$BIN"; then
    rm -f "$bin_tmp"
    echo "Failed to install the awake CLI."
    exit 1
  fi
  if ! write_guard; then
    echo "Failed to generate the background guard safely."
    exit 1
  fi
  if ! write_plist; then
    echo "Failed to generate a valid LaunchDaemon plist."
    exit 1
  fi
  if command -v launchctl >/dev/null 2>&1; then
    launchctl bootout "system/$DLABEL" 2>/dev/null || launchctl unload -w "$PLIST" 2>/dev/null || true
    if ! launchctl bootstrap system "$PLIST" 2>/dev/null && ! launchctl load -w "$PLIST" 2>/dev/null; then
      echo "Failed to register the LaunchDaemon. Check the plist and try the install again."
      exit 1
    fi
    local i
    for i in $(seq 1 10); do
      daemon_loaded && break
      sleep 0.2
    done
    if ! daemon_loaded; then
      echo "LaunchDaemon was registered but is not loaded. Check: awake doctor"
      exit 1
    fi
  fi
  "${AWAKE_PMSET:-/usr/bin/pmset}" -a disablesleep 0 2>/dev/null

  if [ "$quiet" -eq 0 ]; then
    echo "Installed successfully! The root background service is running and sleep is normal."
    echo "Daily use needs no admin or password. Try:"
    echo "    awake            # Launch live Trading Terminal"
    echo "    awake -t 1h      # Timed session"
    echo "    awake -b 25      # Set battery cutoff to 25% (default: 30%)"
    echo "    awake --help     # Full options & cheatsheet"
  fi
  exit 0
}

uninstall_awake() {
  [ "$(id -u)" -eq 0 ] || { echo "Run:  sudo awake --uninstall"; exit 1; }
  if command -v launchctl >/dev/null 2>&1; then
    launchctl bootout "system/$DLABEL" 2>/dev/null \
      || launchctl unload -w "$PLIST" 2>/dev/null
  fi
  "${AWAKE_PMSET:-/usr/bin/pmset}" -a disablesleep 0 2>/dev/null
  rm -f "$PLIST" "$GUARD_BIN" "$BIN"
  rm -rf "$SUPPORT" 2>/dev/null
  echo "Removed awake and its service. Sleep is back to normal."
  exit 0
}

# ---- Trading Terminal TUI ----

terminal_width() {
  local width="${COLUMNS:-}"
  if ! [[ "$width" =~ ^[0-9]+$ ]]; then
    width=$(tput cols 2>/dev/null || echo 80)
  fi
  [[ "$width" =~ ^[0-9]+$ ]] || width=80
  echo "$width"
}

render_compact_view() {
  local rem_str="$1" end_str="$2" pct="$3" elapsed_str="$4" pwr_str="$5" notice="$6" is_paused="$7" show_help="$8" b_guard="$9" b_thresh="${10}" daemon_state="${11}" sleep_state="${12}"
  local b_label="OFF"
  [ "$b_guard" -eq 1 ] && [ "$b_thresh" -gt 0 ] && b_label="ON <=${b_thresh}%"

  printf "MacAwake v%s | Sleep: %s | Daemon: %s\n" "$VERSION" "$sleep_state" "$daemon_state"
  printf "Session: PID %s | Power: %s | Battery guard: %s\n" "$$" "$pwr_str" "$b_label"
  printf "Remaining: %s | Target: %s | Progress: %s%% | Elapsed: %s\n" "$rem_str" "$end_str" "$pct" "$elapsed_str"
  printf "Status: %s\n" "$notice"
  if [ "$show_help" -eq 1 ]; then
    printf "Keys: +/e extend  - shorten  t timer  p pause  d display  b battery  r command  q quit\n"
  else
    printf "Keys: +/e extend  - shorten  t timer  p pause  b battery  ? help  q quit\n"
  fi
}

render_terminal_view() {
  local rem_str="$1" end_str="$2" pct="$3" elapsed_str="$4" pwr_str="$5" notice="$6" is_paused="$7" show_help="$8" b_guard="$9" b_thresh="${10}" daemon_state="${11}" sleep_state="${12}" compact="${13:-0}"

  if [ "$compact" -eq 1 ] || [ "${AWAKE_ASCII:-0}" -eq 1 ]; then
    render_compact_view "$rem_str" "$end_str" "$pct" "$elapsed_str" "$pwr_str" "$notice" "$is_paused" "$show_help" "$b_guard" "$b_thresh" "$daemon_state" "$sleep_state"
    return
  fi
  
  printf "${C_CYAN}╔══════════════════════════════════════════════════════════════════════════════╗${C_RESET}\n"
  printf "${C_CYAN}║${C_RESET}  ${C_BOLD}MACAWAKE TRADING TERMINAL  v${VERSION}${C_RESET}                     ${C_GREEN}%s${C_RESET}    ${C_CYAN}║${C_RESET}\n" "$daemon_state"
  printf "${C_CYAN}╚══════════════════════════════════════════════════════════════════════════════╝${C_RESET}\n"
  
  if [ "$show_help" -eq 1 ]; then
    printf "${C_BLUE}┌────────────────── TRADING TERMINAL MANUAL & CHEAT SHEET ───────────────────┐${C_RESET}\n"
    printf "${C_BLUE}│${C_RESET}  ${C_BOLD}HOTKEY${C_RESET}     ${C_BOLD}ACTION${C_RESET}                                                         ${C_BLUE}│${C_RESET}\n"
    printf "${C_BLUE}│${C_RESET}  [+] / [e]  Extend insomnia timer by +15 minutes                           ${C_BLUE}│${C_RESET}\n"
    printf "${C_BLUE}│${C_RESET}  [-]        Reduce insomnia timer by -15 minutes                           ${C_BLUE}│${C_RESET}\n"
    printf "${C_BLUE}│${C_RESET}  [t]        Set target duration (e.g. '45m', '2h', '1h30m', 'inf')         ${C_BLUE}│${C_RESET}\n"
    printf "${C_BLUE}│${C_RESET}  [p] / [spc]Pause or resume insomnia on the fly (temporarily normal sleep) ${C_BLUE}│${C_RESET}\n"
    printf "${C_BLUE}│${C_RESET}  [d]        Sleep display backlight (runs headless, prevents heat in lid)  ${C_BLUE}│${C_RESET}\n"
    printf "${C_BLUE}│${C_RESET}  [b]        Set or toggle battery guard threshold (sleeps if batt <= N%%)   ${C_BLUE}│${C_RESET}\n"
    printf "${C_BLUE}│${C_RESET}  [r]        Run shell command while keeping Mac awake                      ${C_BLUE}│${C_RESET}\n"
    printf "${C_BLUE}│${C_RESET}  [?] / [h]  Close this cheat sheet                                         ${C_BLUE}│${C_RESET}\n"
    printf "${C_BLUE}│${C_RESET}  [q]        Restore sleep and exit cleanly                                 ${C_BLUE}│${C_RESET}\n"
    printf "${C_BLUE}└─────────────────────────────────────────────────────────────────────────────┘${C_RESET}\n"
  else
    printf "  ${C_BOLD}[SYSTEM TICKER]${C_RESET}\n"
    if [ "$sleep_state" = "PAUSED" ]; then
      printf "  STATUS  : ${C_YELLOW}○ SLEEP NORMAL (Paused)${C_RESET} (Mac will sleep normally)\n"
    elif [ "$sleep_state" = "DISABLED" ]; then
      printf "  STATUS  : ${C_GREEN}● SLEEP DISABLED${C_RESET} (Mac stays awake even with lid closed)\n"
    elif [ "$sleep_state" = "STARTING" ]; then
      printf "  STATUS  : ${C_YELLOW}○ STARTING${C_RESET} (Waiting for daemon confirmation)\n"
    elif [ "$sleep_state" = "DEGRADED" ] || [ "$sleep_state" = "UNAVAILABLE" ] || [ "$sleep_state" = "UNKNOWN" ]; then
      printf "  STATUS  : ${C_RED}○ PROTECTION LOST${C_RESET} (Run: awake doctor)\n"
    else
      printf "  STATUS  : ${C_YELLOW}○ SLEEP NORMAL${C_RESET} (Mac may sleep normally)\n"
    fi

    local b_label="${C_YELLOW}DISABLED${C_RESET}"
    if [ "$b_guard" -eq 1 ] && [ "$b_thresh" -gt 0 ]; then
      b_label="${C_GREEN}ACTIVE (<=${b_thresh}%)${C_RESET}"
    fi

    printf "  POWER   : %-30s │ BATT GUARD : %b\n" "$pwr_str" "$b_label"
    printf "  SESSION : PID %-24s │ DAEMON     : ${C_GREEN}%s${C_RESET}\n" "$$ ($(whoami))" "$daemon_state"
    printf "\n"
    printf "  ${C_BOLD}[COUNTDOWN TICKER]${C_RESET}\n"
    printf "  REMAINING : ${C_CYAN}${C_BOLD}%-24s${C_RESET} TARGET   : %s\n" "$rem_str" "$end_str"
    printf "  PROGRESS  : ${C_MAGENTA}"
    progress_bar "$pct" 22
    printf "${C_RESET}  ${C_DIM}(%s elapsed)${C_RESET}\n" "$elapsed_str"
  fi

  printf "\n"
  printf "  ${C_BOLD}[STATUS LOG]${C_RESET}\n"
  printf "  ${C_YELLOW}FEED > %s${C_RESET}\n" "$notice"
  printf "\n"
  printf "${C_DIM}────────────────────────────────────────────────────────────────────────────────${C_RESET}\n"
  printf "  ${C_BOLD}HOTKEYS:${C_RESET}\n"
  printf "   ${C_CYAN}[+] / [e]${C_RESET} +15m       ${C_CYAN}[-]${C_RESET} -15m          ${C_CYAN}[t]${C_RESET} Set Duration     ${C_CYAN}[p]${C_RESET} Pause/Resume\n"
  printf "   ${C_CYAN}[d]${C_RESET} Sleep Display   ${C_CYAN}[b]${C_RESET} Battery Guard  ${C_CYAN}[r]${C_RESET} Run Command      ${C_CYAN}[?]${C_RESET} Help Overlay\n"
  printf "   ${C_RED}[q]${C_RESET} Exit / Restore Sleep\n"
  printf "${C_DIM}────────────────────────────────────────────────────────────────────────────────${C_RESET}\n"
}

run_interactive_terminal() {
  local target_secs="$1"
  local initial_label="$2"

  if ! check_battery_guard_preflight; then
    exit 1
  fi

  load_config
  local batt_guard=$BATT_GUARD
  local batt_threshold=$BATT_THRESHOLD

  local start_time
  start_time=$(date +%s)
  local duration=$target_secs
  local until_time=0
  if [ "$duration" -gt 0 ]; then
    until_time=$(( start_time + duration ))
  fi

  session_set on $$ "$until_time"

  if ! poll_until 1; then
    handle_poll_failure 1
    session_remove $$
    SESSION_FILE=""
    exit 1
  fi

  TUI_ACTIVE=1
  local stty_orig
  stty_orig=$(stty -g 2>/dev/null || true)
  printf '\033[?1049h\033[?25l' # Enter alternate screen buffer & hide cursor

  tui_reset_terminal() {
    printf '\033[?1049l\033[?25h\033[0m\n'
    [ -n "$stty_orig" ] && stty "$stty_orig" 2>/dev/null || true
  }

  local paused=0
  local notice_msg="Sleep prevention ACTIVE. Lid closed is OK. Press [?] for cheat sheet."
  local show_help_modal=0
  local loop_count=0
  local compact=0
  get_power_info

  while true; do
    local now
    now=$(date +%s)
    loop_count=$(( loop_count + 1 ))

    if [ $(( loop_count % 5 )) -eq 0 ]; then
      get_power_info
    fi

    [ "$(terminal_width)" -lt 90 ] && compact=1 || compact=0
    daemon_health_state "$paused" >/dev/null
    local sleep_state="NORMAL"
    case "$DAEMON_HEALTH_STATE" in
      HEALTHY) sleep_state="DISABLED" ;;
      PAUSED) sleep_state="PAUSED" ;;
      STARTING) sleep_state="STARTING" ;;
      DEGRADED|UNAVAILABLE|UNKNOWN) sleep_state="$DAEMON_HEALTH_STATE" ;;
    esac
    if [ "$DAEMON_HEALTH_STATE" = "DEGRADED" ] || [ "$DAEMON_HEALTH_STATE" = "UNAVAILABLE" ] || [ "$DAEMON_HEALTH_STATE" = "UNKNOWN" ]; then
      notice_msg="Protection lost: daemon is $DAEMON_HEALTH_STATE. Run awake doctor."
    fi

    # Battery guard check with user threshold
    if [ "$batt_guard" -eq 1 ] && [ "$batt_threshold" -gt 0 ] && [ "$BATT_SRC" = "Battery Power" ]; then
      if [ -n "$BATT_PCT" ] && [ "$BATT_PCT" -le "$batt_threshold" ] 2>/dev/null; then
        notice_msg="⚠️ BATTERY LOW (${BATT_PCT}% <= ${batt_threshold}%). Sleep restored to protect battery!"
        paused=1
        session_set paused $$ 0
      fi
    fi

    local rem_secs=0
    local rem_str="INDEFINITE (∞)"
    local end_str="Until stopped"
    local pct=0
    local elapsed=$(( now - start_time ))
    local elapsed_str
    elapsed_str=$(fmt_duration "$elapsed")

    if [ "$until_time" -gt 0 ]; then
      rem_secs=$(( until_time - now ))
      if [ "$rem_secs" -le 0 ]; then
        notice_msg="Time is up ($initial_label). Restoring normal sleep..."
        printf '\033[H'
        local pwr_label="AC Connected (${BATT_PCT}%)"
        [ "$BATT_SRC" = "Battery Power" ] && pwr_label="Battery (${BATT_PCT}%)"
        render_terminal_view "00h 00m 00s" "$end_str" 100 "$elapsed_str" "$pwr_label" "$notice_msg" "$paused" "$show_help_modal" "$batt_guard" "$batt_threshold" "$DAEMON_HEALTH_STATE" "$sleep_state" "$compact"
        sleep 1.2
        break
      fi
      rem_str=$(fmt_duration "$rem_secs")
      end_str=$(date -r "$until_time" '+%H:%M:%S' 2>/dev/null || date -d "@$until_time" '+%H:%M:%S' 2>/dev/null || echo "Active")
      local total_span=$(( until_time - start_time ))
      if [ "$total_span" -gt 0 ]; then
        pct=$(( (elapsed * 100) / total_span ))
      fi
    fi

    local pwr_display="AC Connected (${BATT_PCT}%)"
    if [ "$BATT_SRC" = "Battery Power" ]; then
      local trem="${BATT_TIME:+ ($BATT_TIME)}"
      pwr_display="Battery (${BATT_PCT}%$trem)"
    fi

    printf '\033[H'
    render_terminal_view "$rem_str" "$end_str" "$pct" "$elapsed_str" "$pwr_display" "$notice_msg" "$paused" "$show_help_modal" "$batt_guard" "$batt_threshold" "$DAEMON_HEALTH_STATE" "$sleep_state" "$compact"

    local key=""
    read -s -n 1 -t 1 key 2>/dev/null || true

    if [ -n "$key" ]; then
      case "$key" in
        +|e|E)
          if [ "$until_time" -le 0 ]; then
            start_time=$now
            until_time=$(( now + 900 ))
          else
            until_time=$(( until_time + 900 ))
          fi
          duration=$(( until_time - start_time ))
          session_set on $$ "$until_time"
          local new_target
          new_target=$(date -r "$until_time" '+%H:%M:%S' 2>/dev/null || date -d "@$until_time" '+%H:%M:%S' 2>/dev/null)
          notice_msg="[$(date '+%H:%M:%S')] Added +15m (Target: $new_target)"
          ;;
        -)
          if [ "$until_time" -gt 0 ]; then
            local n_until=$(( until_time - 900 ))
            if [ "$n_until" -le "$(( now + 10 ))" ]; then
              until_time=$(( now + 10 ))
            else
              until_time=$n_until
            fi
            duration=$(( until_time - start_time ))
            session_set on $$ "$until_time"
            notice_msg="[$(date '+%H:%M:%S')] Reduced timer by -15m"
          else
            notice_msg="Timer is indefinite. Press [+] or [t] to set a countdown."
          fi
          ;;
        t|T)
          printf '\033[?25h'
          printf '\033[23;1H\033[K\033[1;33mFEED > Enter duration (e.g. 45m, 2h, 30s, inf):\033[0m '
          local user_dur=""
          read -r user_dur
          printf '\033[?25l'
          if [ "$user_dur" = "inf" ] || [ "$user_dur" = "0" ] || [ -z "$user_dur" ]; then
            until_time=0
            duration=0
            session_set on $$ 0
            notice_msg="[$(date '+%H:%M:%S')] Timer changed to INDEFINITE"
          else
            local parsed_secs
            parsed_secs=$(to_seconds "$user_dur")
            if [ -n "$parsed_secs" ] && [ "$parsed_secs" -gt 0 ]; then
              start_time=$now
              until_time=$(( now + parsed_secs ))
              duration=$parsed_secs
              session_set on $$ "$until_time"
              local new_target
              new_target=$(date -r "$until_time" '+%H:%M:%S' 2>/dev/null || date -d "@$until_time" '+%H:%M:%S' 2>/dev/null)
              notice_msg="[$(date '+%H:%M:%S')] Timer set to $user_dur (Target: $new_target)"
            else
              notice_msg="[$(date '+%H:%M:%S')] Invalid duration '$user_dur'"
            fi
          fi
          ;;
        p|P|" ")
          if [ "$paused" -eq 0 ]; then
            paused=1
            session_set paused $$ "$until_time"
            request_set off
            notice_msg="[$(date '+%H:%M:%S')] PAUSED: Normal sleep restored temporarily"
          else
            paused=0
            session_set on $$ "$until_time"
            poll_until 1
            notice_msg="[$(date '+%H:%M:%S')] RESUMED: Mac stays awake (lid closed OK)"
          fi
          ;;
        d|D)
          "$PM" displaysleepnow 2>/dev/null || true
          notice_msg="[$(date '+%H:%M:%S')] Display backlight turned off to cool Mac. Tap any key to wake display."
          ;;
        b|B)
          printf '\033[?25h'
          printf '\033[23;1H\033[K\033[1;33mFEED > Battery cutoff %% [current: %s%%, "off" to disable, or Enter to toggle]:\033[0m ' "$batt_threshold"
          local user_b=""
          read -r user_b
          printf '\033[?25l'
          user_b=$(echo "$user_b" | tr -d '% ')
          if [ -z "$user_b" ]; then
            if [ "$batt_guard" -eq 1 ]; then
              batt_guard=0
              BATT_GUARD=0
              if save_config; then
                notice_msg="[$(date '+%H:%M:%S')] Battery Safeguard: DISABLED"
              else
                notice_msg="[$(date '+%H:%M:%S')] Battery preference could not be saved"
              fi
            else
              batt_guard=1
              BATT_GUARD=1
              if save_config; then
                notice_msg="[$(date '+%H:%M:%S')] Battery Safeguard: ENABLED (Cutoff: <=${batt_threshold}%)"
              else
                notice_msg="[$(date '+%H:%M:%S')] Battery preference could not be saved"
              fi
            fi
          elif [ "$user_b" = "off" ] || [ "$user_b" = "0" ] || [ "$user_b" = "disable" ]; then
            batt_guard=0
            BATT_GUARD=0
            if save_config; then
              notice_msg="[$(date '+%H:%M:%S')] Battery Safeguard: DISABLED"
            else
              notice_msg="[$(date '+%H:%M:%S')] Battery preference could not be saved"
            fi
          elif [[ "$user_b" =~ ^[0-9]+$ ]] && [ "$user_b" -ge 1 ] && [ "$user_b" -le 100 ]; then
            batt_guard=1
            batt_threshold="$user_b"
            BATT_GUARD=1
            BATT_THRESHOLD="$user_b"
            if save_config; then
              notice_msg="[$(date '+%H:%M:%S')] Battery Safeguard: ENABLED (Cutoff: <=${batt_threshold}%)"
            else
              notice_msg="[$(date '+%H:%M:%S')] Battery preference could not be saved"
            fi
          else
            notice_msg="[$(date '+%H:%M:%S')] Invalid threshold '$user_b'. Enter 1-100 or 'off'."
          fi
          ;;
        r|R)
          printf '\033[?25h\033[2J\033[H'
          echo -e "${C_CYAN}=== Execute Command Under MacAwake ===${C_RESET}"
          echo "Mac will stay awake while this command executes."
          echo
          read -p "Command to run: " -r user_cmd
          if [ -n "$user_cmd" ]; then
            echo -e "${C_DIM}Running: $user_cmd${C_RESET}\n"
            eval "$user_cmd"
            local cmd_code=$?
            echo
            echo -e "${C_YELLOW}Command exited with code $cmd_code.${C_RESET}"
            read -r -p "Press Enter to return to Trading Terminal..."
          fi
          printf '\033[?25l\033[2J'
          notice_msg="[$(date '+%H:%M:%S')] Returned from command execution"
          ;;
        \?|h|H)
          show_help_modal=$(( 1 - show_help_modal ))
          ;;
        q|Q)
          printf '\033[?25h'
          printf '\033[23;1H\033[K\033[1;31mFEED > Exit and restore normal sleep? [Y/n]:\033[0m '
          local ans=""
          read -r -n 1 ans
          printf '\033[?25l'
          if [ -z "$ans" ] || [ "$ans" = "y" ] || [ "$ans" = "Y" ]; then
            break
          else
            notice_msg="[$(date '+%H:%M:%S')] Exit cancelled"
          fi
          ;;
      esac
    fi
  done

  tui_reset_terminal
}

# ---- Exit & Signal Cleanup ----

cleanup() {
  trap - EXIT INT TERM HUP; trap '' USR1
  [ -z "$SESSION_FILE" ] && return 0

  printf '\033[?1049l\033[?25h\033[0m' 2>/dev/null || true
  stty echo 2>/dev/null || true

  for pid in "$CMD_PID" "$TIMER_PID" "$IDLE_PID"; do
    if [ -n "$pid" ]; then
      local children
      children=$(pgrep -P "$pid" 2>/dev/null || true)
      kill "$pid" $children 2>/dev/null || true
    fi
  done

  session_remove "$$"

  if [ "$TUI_ACTIVE" -eq 1 ]; then
    echo "Sleep restored. Have a great day!"
  else
    echo
    if poll_until 0; then
      echo "Sleep restored."
    else
      echo "WARNING: sleep may still be disabled. Run:  awake --off"
    fi
  fi
}

# ---- Command Line Parsing ----

INTERACTIVE_FORCE=0
PLAIN_FORCE=0
SECS=0
LABEL="indefinite"

while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help|help)
      show_help
      exit 0
      ;;
    -v|--version|version)
      show_version
      exit 0
      ;;
    -d|--doctor|doctor)
      run_doctor
      exit 0
      ;;
    -s|--status|status)
      show_status
      exit 0
      ;;
    --off|off)
      if [ "${2:-}" = "--all" ]; then
        shift 2
        turn_off
      elif [ -n "${2:-}" ] && [[ "$2" =~ ^[0-9]+$ ]]; then
        local_off_pid="$2"
        shift 2
        turn_off "$local_off_pid"
      else
        shift
        turn_off
      fi
      exit 0
      ;;
    -b|--battery-guard|--battery)
      if [ -n "${2:-}" ] && [[ "$2" =~ ^[0-9]+%?$ || "$2" = "off" || "$2" = "disable" || "$2" = "0" ]]; then
        set_battery_pref "$2"
        shift 2
        exit 0
      elif [ -z "${2:-}" ] || [ "${2:-}" = "status" ] || [ "${2:-}" = "show" ]; then
        show_battery_pref
        [ -n "${2:-}" ] && shift 2 || shift
        exit 0
      else
        set_battery_pref "$2"
        exit 1
      fi
      ;;
    config)
      shift
      if [ "${1:-}" = "battery" ] || [ "${1:-}" = "batt" ] || [ "${1:-}" = "-b" ]; then
        if [ -n "${2:-}" ]; then
          set_battery_pref "$2"
        else
          show_battery_pref
        fi
        exit 0
      else
        echo "Usage: awake config battery [percent|off]"
        exit 1
      fi
      ;;
    --install)
      shift
      install_awake "$@"
      ;;
    --uninstall)
      uninstall_awake
      ;;
    -i|--interactive|shell|interactive)
      INTERACTIVE_FORCE=1
      shift
      ;;
    --plain)
      PLAIN_FORCE=1
      shift
      ;;
    -t)
      [ -n "$2" ] || { echo "Usage: awake -t <time> [command...]"; exit 1; }
      SECS=$(to_seconds "$2") && [ "$SECS" -gt 0 ] \
        || { echo "Invalid time '$2'. Examples: 45, 30m, 2h, 1h30m"; exit 1; }
      LABEL="$2"
      shift 2
      ;;
    --)
      shift
      break
      ;;
    -*)
      echo "Unknown option: $1"
      echo "Run 'awake --help' for usage."
      exit 1
      ;;
    *)
      break
      ;;
  esac
done

[ -d "$SUPPORT" ] || not_set_up

# ---- Execution Modes ----

trap cleanup EXIT
trap 'exit 130' INT TERM HUP
trap 'echo; echo "Time is up ($LABEL)."; exit 0' USR1

NOW=$(date +%s)
UNTIL=0
[ "$SECS" -gt 0 ] && UNTIL=$((NOW + SECS))

if [ $# -gt 0 ]; then
  # 1. Command Execution Mode (stays awake while command runs)
  if ! check_battery_guard_preflight; then
    exit 1
  fi
  session_set on $$ "$UNTIL"
  if ! poll_until 1; then
    handle_poll_failure 1
    session_remove $$
    SESSION_FILE=""
    exit 1
  fi

  if [ "$SECS" -gt 0 ]; then
    echo "Staying awake for $LABEL while running command: $*"
    ( sleep "$SECS"; kill -USR1 $$ ) 2>/dev/null & TIMER_PID=$!
  else
    echo "Staying awake while running command: $*"
  fi

  "$@" & CMD_PID=$!
  wait "$CMD_PID"; STATUS=$?; CMD_PID=""
  exit "$STATUS"

elif [ "$INTERACTIVE_FORCE" -eq 1 ] || { [ "$PLAIN_FORCE" -eq 0 ] && [ -t 0 ]; }; then
  # 2. Interactive Trading Terminal Mode
  run_interactive_terminal "$SECS" "$LABEL"
  exit 0

else
  # 3. Plain Background / Script Mode
  if ! check_battery_guard_preflight; then
    exit 1
  fi
  session_set on $$ "$UNTIL"
  if ! poll_until 1; then
    handle_poll_failure 1
    session_remove $$
    SESSION_FILE=""
    exit 1
  fi

  if [ "$SECS" -gt 0 ]; then
    echo "Staying awake for $LABEL. Lid closed is OK. Ctrl+C to stop early."
    ( sleep "$SECS"; kill -USR1 $$ ) 2>/dev/null & TIMER_PID=$!
  else
    echo "Staying awake, lid closed is OK. Press Ctrl+C to stop."
  fi

  while true; do sleep 3600 & IDLE_PID=$!; wait "$IDLE_PID"; done
fi
